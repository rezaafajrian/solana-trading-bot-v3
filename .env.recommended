# =====================================================================
# Recommended risk-managed starting config.
# Copy to ".env" and fill in the three required values marked TODO.
# Start SMALL on a FRESH wallet — these settings cut losses, they do not
# guarantee profit. Meme sniping is high risk.
# =====================================================================

# Wallet
# TODO: paste the private key of a FRESH, low-balance wallet (base58 or [..] array).
PRIVATE_KEY=

# Connection
# TODO: use a private RPC (Helius / QuickNode). The public endpoint is too slow
# and rate-limited for sniping — you will miss pools and land late.
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com
COMMITMENT_LEVEL=confirmed

# Bot
LOG_LEVEL=info
ONE_TOKEN_AT_A_TIME=true
PRE_LOAD_EXISTING_MARKETS=false
CACHE_NEW_MARKETS=false
# 'jito' lands transactions fastest in congestion. Falls back to CUSTOM_FEE below.
# Use 'default' only if you can't use jito; then DYNAMIC_COMPUTE_UNIT_PRICE helps.
TRANSACTION_EXECUTOR=jito
COMPUTE_UNIT_LIMIT=101337
COMPUTE_UNIT_PRICE=421197
# Only used by the 'default' executor. Harmless to leave on.
DYNAMIC_COMPUTE_UNIT_PRICE=true
MAX_COMPUTE_UNIT_PRICE=1000000
# Used by jito / warp. 0.006 SOL is a sane competitive tip.
CUSTOM_FEE=0.006

# Buy
QUOTE_MINT=WSOL
# Start tiny while you validate behavior. Raise only once you trust it.
QUOTE_AMOUNT=0.01
AUTO_BUY_DELAY=0
MAX_BUY_RETRIES=5
BUY_SLIPPAGE=20

# Sell
AUTO_SELL=true
MAX_SELL_RETRIES=10
AUTO_SELL_DELAY=0
PRICE_CHECK_INTERVAL=2000
PRICE_CHECK_DURATION=600000
# Hard ceiling exit if it rips before the trailing stop reacts.
TAKE_PROFIT=100
STOP_LOSS=30
SELL_SLIPPAGE=20
# Once in profit, ride the price up and exit if it falls 25% from its peak.
TRAILING_STOP_LOSS=25
# Bank half the position at +50% (recovers most of your cost), trail the rest.
PARTIAL_TAKE_PROFIT=50
PARTIAL_SELL_PERCENT=50

# Filters
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=30000
FILTER_CHECK_DURATION=60000
FILTER_CHECK_INTERVAL=2000
# Pool must stay clean across several checks, not just flash clean once.
CONSECUTIVE_FILTER_MATCHES=5
CHECK_IF_MUTABLE=false
CHECK_IF_SOCIALS=true
CHECK_IF_MINT_IS_RENOUNCED=true
CHECK_IF_FREEZABLE=true
CHECK_IF_BURNED=true
CHECK_IF_HONEYPOT=true
MAX_TOKEN_TAX=500
CHECK_TOP_HOLDERS=true
MAX_TOP_HOLDER_PERCENTAGE=30
CHECK_LP_LOCKED=true
MIN_LP_LOCKED_PERCENT=95
# Strongest honeypot protection but adds latency. Turn on if safety > speed for you.
SIMULATE_SELL_BEFORE_BUY=false
MIN_POOL_SIZE=5
MAX_POOL_SIZE=100

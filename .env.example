# Wallet
PRIVATE_KEY=

# Connection 
# You may also consider switching to a faster RPC provider to improve performance.
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com
COMMITMENT_LEVEL=confirmed

# Bot
LOG_LEVEL=trace
ONE_TOKEN_AT_A_TIME=true
PRE_LOAD_EXISTING_MARKETS=false
CACHE_NEW_MARKETS=false
# default or warp or jito
TRANSACTION_EXECUTOR=default
# if using default executor, fee below will be applied
COMPUTE_UNIT_LIMIT=101337
COMPUTE_UNIT_PRICE=421197
# Set the priority fee automatically from recent network congestion (default executor only).
# COMPUTE_UNIT_PRICE acts as the floor, MAX_COMPUTE_UNIT_PRICE as the ceiling (micro lamports).
DYNAMIC_COMPUTE_UNIT_PRICE=false
MAX_COMPUTE_UNIT_PRICE=1000000
# if using warp or jito executor, fee below will be applied
CUSTOM_FEE=0.006

# Buy
# SOL = use native SOL (the bot auto-wraps/unwraps, no manual wrapping needed).
# WSOL = use a pre-funded WSOL token account. USDC = use USDC.
QUOTE_MINT=SOL
QUOTE_AMOUNT=0.001
AUTO_BUY_DELAY=0
MAX_BUY_RETRIES=10
BUY_SLIPPAGE=20

# Sell
AUTO_SELL=true
MAX_SELL_RETRIES=10
AUTO_SELL_DELAY=0
PRICE_CHECK_INTERVAL=2000
PRICE_CHECK_DURATION=600000
TAKE_PROFIT=40
STOP_LOSS=20
SELL_SLIPPAGE=20
# Trailing stop loss: sell if price drops this % from its peak (after going into profit). 0 = disabled.
TRAILING_STOP_LOSS=0
# Partial take profit: sell PARTIAL_SELL_PERCENT of the position once up PARTIAL_TAKE_PROFIT%, then trail the rest.
# Set both to 0 to disable (sell the whole position at TAKE_PROFIT).
PARTIAL_TAKE_PROFIT=0
PARTIAL_SELL_PERCENT=0

# Filters
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=30000
FILTER_CHECK_DURATION=60000
FILTER_CHECK_INTERVAL=2000
CONSECUTIVE_FILTER_MATCHES=3
CHECK_IF_MUTABLE=false
CHECK_IF_SOCIALS=true
CHECK_IF_MINT_IS_RENOUNCED=true
CHECK_IF_FREEZABLE=false
CHECK_IF_BURNED=true
# Honeypot protection: reject Token-2022 tokens that can block sells or let the creator seize tokens.
CHECK_IF_HONEYPOT=true
# Max allowed transfer tax in basis points (100 = 1%). 10000 = no limit.
MAX_TOKEN_TAX=500
# Holder concentration: reject pools where a single non-pool wallet holds too much of the supply.
CHECK_TOP_HOLDERS=false
MAX_TOP_HOLDER_PERCENTAGE=30
# LP locked %: reject pools unless at least this % of LP has been burned/locked (more precise than CHECK_IF_BURNED).
CHECK_LP_LOCKED=false
MIN_LP_LOCKED_PERCENT=95
# Honeypot round-trip test: simulate buy->sell on-chain before buying and skip if the sell fails.
# Strong protection but adds latency (costs snipe speed).
SIMULATE_SELL_BEFORE_BUY=false
MIN_POOL_SIZE=5
MAX_POOL_SIZE=50
